# Manual Pipeline Commands — *Ampullaceana balthica* 16S

> Run these commands from the project root inside the QIIME2 environment:
> ```bash
> conda activate qiime2-amplicon-2026.1
> cd "/mnt/c/Users/Utilizador/OneDrive - Instituto Politécnico de Setúbal/Documents/Bioinformatica/Estágio/Ampullaceana balthica"
> ```

---

## Phase 1 — QC, Denoising & Taxonomy

### 1. fastp — Quality filtering (per sample)
```bash
# Replace SAMPLE with e.g. 001, 167, 441 …
SAMPLE=001

mkdir -p quality_Ampullaceana fastp_reports_Ampullaceana

fastp \
  -i 00-Ampullaceana_balthica_raw_data/fastqs/${SAMPLE}_R1.fastq.gz \
  -I 00-Ampullaceana_balthica_raw_data/fastqs/${SAMPLE}_R2.fastq.gz \
  -w 16 \
  -h fastp_reports_Ampullaceana/fastp_${SAMPLE}.html \
  -j fastp_reports_Ampullaceana/fastp_${SAMPLE}.json \
  -o quality_Ampullaceana/out_${SAMPLE}_R1.fastq.gz \
  -O quality_Ampullaceana/out_${SAMPLE}_R2.fastq.gz
```

---

### 2. FastQC + MultiQC — Quality reports
```bash
mkdir -p qc_reports/raw qc_reports/filtered

# Raw reads
fastqc -t 16 -o qc_reports/raw \
  00-Ampullaceana_balthica_raw_data/fastqs/*.fastq.gz

multiqc qc_reports/raw -o qc_reports/raw

# Filtered reads
fastqc -t 16 -o qc_reports/filtered \
  quality_Ampullaceana/out_*.fastq.gz

multiqc qc_reports/filtered -o qc_reports/filtered
```

---

### 3. QIIME2 Import — Build manifest & import
```bash
mkdir -p artifact_Ampullaceana visualizations_Ampullaceana

# Import (manifest.tsv is auto-generated by Snakemake; build it manually if needed)
qiime tools import \
  --type 'SampleData[PairedEndSequencesWithQuality]' \
  --input-path manifest.tsv \
  --output-path artifact_Ampullaceana/ampullaceana_demux.qza \
  --input-format PairedEndFastqManifestPhred33V2

qiime demux summarize \
  --i-data artifact_Ampullaceana/ampullaceana_demux.qza \
  --o-visualization visualizations_Ampullaceana/ampullaceana_demux.qzv
```

---

### 4. Export demux — get per-sample counts
```bash
mkdir -p demux_export_Ampullaceana

qiime tools export \
  --input-path visualizations_Ampullaceana/ampullaceana_demux.qzv \
  --output-path demux_export_Ampullaceana
```

---

### 5. cutadapt — Primer trimming
```bash
qiime cutadapt trim-paired \
  --i-demultiplexed-sequences artifact_Ampullaceana/ampullaceana_demux.qza \
  --p-front-f CCTACGGGNGGCWGCAG \
  --p-front-r GACTACHVGGGTATCTAATCC \
  --p-cores 20 \
  --o-trimmed-sequences artifact_Ampullaceana/ampullaceana_trimmed.qza \
  --verbose

qiime demux summarize \
  --i-data artifact_Ampullaceana/ampullaceana_trimmed.qza \
  --o-visualization visualizations_Ampullaceana/ampullaceana_trimmed.qzv
```

---

### 6. Export trimmed demux — post-cutadapt counts
```bash
mkdir -p trimmed_export_Ampullaceana

qiime tools export \
  --input-path visualizations_Ampullaceana/ampullaceana_trimmed.qzv \
  --output-path trimmed_export_Ampullaceana
```

---

### 7. filter-samples — Remove low-read samples
```bash
qiime demux filter-samples \
  --i-demux artifact_Ampullaceana/ampullaceana_trimmed.qza \
  --m-metadata-file trimmed_export_Ampullaceana/per-sample-fastq-counts.tsv \
  --p-where "CAST([forward sequence count] AS INT) > 100" \
  --o-filtered-demux artifact_Ampullaceana/filtered_demux.qza
```

---

### 8. DADA2 — Denoise
> ⚠️ Memory-intensive — do NOT run this while train_classifier is running.
> Uses 8 threads to avoid OOM kills (each R subprocess uses ~1.5 GB).
```bash
qiime dada2 denoise-paired \
  --i-demultiplexed-seqs artifact_Ampullaceana/filtered_demux_clean.qza \
  --p-trim-left-f 0 \
  --p-trim-left-r 0 \
  --p-trunc-len-f 0 \
  --p-trunc-len-r 0 \
  --p-chimera-method consensus \
  --p-min-fold-parent-over-abundance 8 \
  --p-min-overlap 12 \
  --p-max-ee-f 2.0 \
  --p-max-ee-r 2.0 \
  --p-n-threads 8 \
  --p-no-retain-all-samples \
  --verbose \
  --o-table artifact_Ampullaceana/Ampullaceana_freq_table.qza \
  --o-representative-sequences artifact_Ampullaceana/Ampullaceana_rep_seqs.qza \
  --o-denoising-stats artifact_Ampullaceana/dada2_stats.qza \
  --o-base-transition-stats artifact_Ampullaceana/base_transition_stats.qza

qiime metadata tabulate \
  --m-input-file artifact_Ampullaceana/dada2_stats.qza \
  --o-visualization visualizations_Ampullaceana/dada2_stats.qzv
```

---

### 9. Summarize feature table
```bash
# In QIIME2 2026.1, summarize is now a pipeline with 3 outputs:
qiime feature-table summarize \
  --i-table artifact_Ampullaceana/Ampullaceana_freq_table.qza \
  --m-metadata-file 00-Ampullaceana_balthica_raw_data/Ampullaceana_balthica_metadata.tsv \
  --o-summary visualizations_Ampullaceana/Ampullaceana_freq_table.qzv \
  --o-sample-frequencies visualizations_Ampullaceana/sample_frequencies.qza \
  --o-feature-frequencies visualizations_Ampullaceana/feature_frequencies.qza

qiime feature-table tabulate-seqs \
  --i-data artifact_Ampullaceana/Ampullaceana_rep_seqs.qza \
  --o-visualization visualizations_Ampullaceana/Ampullaceana_rep_seqs.qzv
```

---

### 10. SILVA — Download & prepare reference
```bash
mkdir -p silva_refs

# Download
qiime rescript get-silva-data \
  --p-version 138.2 \
  --p-target SSURef_NR99 \
  --o-silva-sequences silva_refs/rna_origin_silva_ref_seqs.qza \
  --o-silva-taxonomy silva_refs/origin_silva_ref_taxa.qza

# RNA → DNA
qiime rescript reverse-transcribe \
  --i-rna-sequences silva_refs/rna_origin_silva_ref_seqs.qza \
  --o-dna-sequences silva_refs/origin_silva_ref_seqs.qza

# Filter low-quality
qiime rescript cull-seqs \
  --i-sequences silva_refs/origin_silva_ref_seqs.qza \
  --o-clean-sequences silva_refs/cleaned_silva_ref_seqs.qza

qiime rescript filter-seqs-length-by-taxon \
  --i-sequences silva_refs/cleaned_silva_ref_seqs.qza \
  --i-taxonomy silva_refs/origin_silva_ref_taxa.qza \
  --p-labels Archaea Bacteria Eukaryota \
  --p-min-lens 900 1200 1400 \
  --o-filtered-seqs silva_refs/filt_silva_ref_seqs.qza \
  --o-discarded-seqs silva_refs/discard_silva_ref_seqs.qza

qiime rescript dereplicate \
  --i-sequences silva_refs/filt_silva_ref_seqs.qza \
  --i-taxa silva_refs/origin_silva_ref_taxa.qza \
  --p-rank-handles domain \
  --p-mode uniq \
  --o-dereplicated-sequences silva_refs/silva_ref_seqs.qza \
  --o-dereplicated-taxa silva_refs/silva_ref_taxa.qza
```

---

### 11. Train classifier
> ⚠️ Memory-intensive — run alone, not with DADA2.
```bash
qiime feature-classifier fit-classifier-naive-bayes \
  --i-reference-reads silva_refs/silva_ref_seqs.qza \
  --i-reference-taxonomy silva_refs/silva_ref_taxa.qza \
  --o-classifier artifact_Ampullaceana/silva_16S_classifier.qza
```

---

### 12. Classify taxonomy
```bash
qiime feature-classifier classify-sklearn \
  --i-classifier artifact_Ampullaceana/silva_16S_classifier.qza \
  --i-reads artifact_Ampullaceana/Ampullaceana_rep_seqs.qza \
  --p-n-jobs 20 \
  --o-classification artifact_Ampullaceana/Ampullaceana_taxonomy.qza

qiime metadata tabulate \
  --m-input-file artifact_Ampullaceana/Ampullaceana_taxonomy.qza \
  --o-visualization visualizations_Ampullaceana/Ampullaceana_taxonomy.qzv

qiime taxa barplot \
  --i-table artifact_Ampullaceana/Ampullaceana_freq_table.qza \
  --i-taxonomy artifact_Ampullaceana/Ampullaceana_taxonomy.qza \
  --m-metadata-file 00-Ampullaceana_balthica_raw_data/Ampullaceana_balthica_metadata.tsv \
  --o-visualization visualizations_Ampullaceana/taxa_barplot.qzv
```

---

## Phase 2 — Diversity & Statistics

### 13. Phylogenetic tree
```bash
mkdir -p phylogeny_Ampullaceana

qiime phylogeny align-to-tree-mafft-fasttree \
  --i-sequences artifact_Ampullaceana/Ampullaceana_rep_seqs.qza \
  --o-alignment phylogeny_Ampullaceana/aligned_rep_seqs.qza \
  --o-masked-alignment phylogeny_Ampullaceana/masked_aligned_rep_seqs.qza \
  --o-tree phylogeny_Ampullaceana/unrooted_tree.qza \
  --o-rooted-tree phylogeny_Ampullaceana/rooted_tree.qza
```

---

### 14. Alpha rarefaction
> ⚠️ Set `max_depth` in config.yaml before running (check freq_table.qzv for median frequency).
```bash
# Replace MAX_DEPTH with value from freq_table.qzv
MAX_DEPTH=10000

qiime diversity alpha-rarefaction \
  --i-table artifact_Ampullaceana/Ampullaceana_freq_table.qza \
  --i-phylogeny phylogeny_Ampullaceana/rooted_tree.qza \
  --p-max-depth ${MAX_DEPTH} \
  --m-metadata-file 00-Ampullaceana_balthica_raw_data/Ampullaceana_balthica_metadata.tsv \
  --o-visualization visualizations_Ampullaceana/alpha_rarefaction_curves.qzv
```

---

### 15. Core diversity metrics
> ⚠️ Set `raref_depth` in config.yaml first (from alpha rarefaction curve).
```bash
# Replace RAREF_DEPTH with value from alpha_rarefaction_curves.qzv
RAREF_DEPTH=5000

mkdir -p diversity_core_metrics

qiime diversity core-metrics-phylogenetic \
  --i-phylogeny phylogeny_Ampullaceana/rooted_tree.qza \
  --i-table artifact_Ampullaceana/Ampullaceana_freq_table.qza \
  --p-sampling-depth ${RAREF_DEPTH} \
  --m-metadata-file 00-Ampullaceana_balthica_raw_data/Ampullaceana_balthica_metadata.tsv \
  --output-dir diversity_core_metrics
```

---

### Useful QIIME2 tips
```bash
# View any .qzv file
qiime tools view path/to/file.qzv
# Or drag and drop to https://view.qiime2.org

# Dry-run Snakemake (check the DAG without running)
snakemake -s Snakefile_phase1 --configfile config.yaml -n

# Force rerun a specific rule
snakemake -s Snakefile_phase1 --configfile config.yaml \
    --forcerun dada2_denoise --cores 20 --resources mem_intensive=1
```
