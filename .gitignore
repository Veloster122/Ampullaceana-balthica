# ============================================================
# .gitignore for Ampullaceana balthica microbiome pipeline
# Only pipeline CODE is tracked — data and results are NOT
# ============================================================

# --- Raw sequencing data (too large for git) ---
00-Ampullaceana_balthica_raw_data/fastqs/
*.fastq.gz
*.fastq

# --- QIIME2 artifacts (regenerated by pipeline) ---
*.qza
*.qzv

# --- Pipeline outputs (reproducible from data) ---
quality_Ampullaceana/
fastp_reports_Ampullaceana/
artifact_Ampullaceana/
visualizations_Ampullaceana/
demux_export_Ampullaceana/
silva_refs/
phylogeny_Ampullaceana/
diversity_results_viz_Ampullaceana/
diversity_core_metrics/
qc_reports/
glmm_inputs/
glmm_outputs/

# --- Snakemake internals ---
.snakemake/
*.log

# --- Manifest (regenerated at runtime) ---
manifest.tsv
manifest_bfQC.tsv

# --- Temp files ---
*.tmp
tmp_*/
names*.txt

# --- OS & editor ---
.DS_Store
Thumbs.db
*.swp
*.swo

# --- Python, GUI & Security ---
.env
.env.local
secrets.yaml
__pycache__/
*.pyc
build/
dist/
*.spec
Ampullaceana_Resultados.zip
